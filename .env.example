# Copy to .env.local and fill in the values from your EmailJS dashboard.
# These values are embedded in the public JS bundle at build time, so they are
# identifiers, not secrets. Protect the EmailJS account with domain
# allow-listing, rate limits / CAPTCHA, and never put the EmailJS *private*
# key in any client-side env file.
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=your_public_key
